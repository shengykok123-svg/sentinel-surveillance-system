SENTINEL_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/sentinel_db
SENTINEL_JWT_SECRET=change_me
SENTINEL_JWT_ALGORITHM=HS256
SENTINEL_JWT_EXPIRE_MINUTES=60
SENTINEL_RECOGNITION_THRESHOLD=0.53
# Record detections that fell below the threshold, so the event log has a
# denominator for recognition-rate and similarity-distribution analytics.
SENTINEL_PUBLISH_UNKNOWN_EVENTS=true
SENTINEL_ALIGN_ENABLED=true
SENTINEL_ALIGN_MODEL_PACK=buffalo_sc
SENTINEL_ALIGN_MIN_CONFIDENCE=0.5

# YOLOv5-face: defaults to chokePoint Dataset/Detection_Model/yolov5s-face.onnx.
# SENTINEL_DETECTION_MODEL_PATH=/absolute/path/to/yolov5s-face.onnx
SENTINEL_CONF_THRESH=0.45
SENTINEL_DETECTION_NMS_THRESH=0.4

# Provisional CR-FIQA(S) registration quality threshold (raw score).
SENTINEL_ENROLLMENT_QUALITY_THRESHOLD=1.8852214813232422

# Live selection: retain three spaced candidates; CR-FIQA ranks them, AdaFace embeds two.
SENTINEL_RECOGNITION_COLLECT_SECONDS=0.8
SENTINEL_RECOGNITION_SAMPLE_SECONDS=0.2
SENTINEL_RECOGNITION_VOTE_SECONDS=2.0
# Provisional margin between the best two DISTINCT identities, not templates.
SENTINEL_RECOGNITION_IDENTITY_MARGIN=0.05
SENTINEL_RECOGNITION_MIN_FACE_SIZE=0
SENTINEL_ENROLLMENT_MIN_FACE_SIZE=48
SENTINEL_RECOGNITION_MIN_DET_SCORE=0.60
SENTINEL_RECOGNITION_MIN_BLUR_VAR=40
SENTINEL_RECOGNITION_MAX_GOOD_MISSES=4

# Live CR-FIQA gate: provisional raw cutoff, independent from enrollment.
# Below threshold => no AdaFace call. One passing image is sufficient to match.
SENTINEL_LIVE_QUALITY_THRESHOLD=1.23059
SENTINEL_LIVE_QUALITY_RETRY_SECONDS=0.2
# Enrollment augmentation (local demo / consenting participants)
# Default runtime paths point at workspace/.external; override for another installation.
SENTINEL_ENROLLMENT_ENHANCEMENT_ENABLED=true
SENTINEL_ENROLLMENT_GENERATION_TIMEOUT=180
# SENTINEL_LIVEPORTRAIT_PYTHON=C:/path/to/liveportrait-env/Scripts/python.exe
# SENTINEL_LIVEPORTRAIT_REPOSITORY=C:/path/to/LivePortrait

# Retry unmatched tracks while a clearer face may still appear.
SENTINEL_UNKNOWN_COOLDOWN_SECONDS=0.5
